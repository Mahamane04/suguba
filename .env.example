# ==============================================================================
# SUGUBA SAAS — VARIABLES D'ENVIRONNEMENT DE PRODUCTION
# Conforme aux spécifications MicroOffice SaaS Factory V3.1
# ==============================================================================

# 1. URL DE L'APPLICATION
NEXT_PUBLIC_APP_URL="https://app.sugubaml.com"
PORT=3000

# 2. BASE DE DONNÉES POSTGRESQL & SUPABASE CLOUD
# (Laissez vide pour le mode Local Offline-First / Démo automatique)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"
# ⚠️ SUPABASE_SERVICE_ROLE_KEY est maintenant utilisée côté serveur pour
# authentifier les comptes et gérer les retraits (src/lib/supabase-admin.ts).
# Ne JAMAIS la préfixer par NEXT_PUBLIC_, ne jamais la commiter avec une
# vraie valeur, ne jamais l'importer dans un fichier 'use client'.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 2bis. SESSION & OTP (obligatoires — l'app refuse de démarrer sans
# SESSION_SECRET dès qu'une route d'authentification est appelée)
# Générez une valeur aléatoire d'au moins 32 caractères, ex :
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-char-secret"
OTP_PEPPER="change-me-to-a-different-random-secret"

# 2ter. MODE DÉMO — laisser désactivé (commenté) en production.
# Active la "Connexion rapide" sans OTP sur /login. Les deux variables
# doivent être définies ensemble : SUGUBA_DEMO_MODE (contrôle serveur réel)
# et NEXT_PUBLIC_DEMO_MODE (affiche juste le bouton côté client).
# SUGUBA_DEMO_MODE="true"
# NEXT_PUBLIC_DEMO_MODE="true"

# 3. SASPAY — SEULE PASSERELLE DE PAIEMENT (encaissement + versement)
# Compte et clés : https://app.saspay.me (section Développeur).
# Documentation : https://docs.saspay.me
#
# SASPAY_API_KEY authentifie tous les appels (Authorization: Bearer).
# Elle doit avoir le scope PAYIN pour encaisser, PAYOUT pour verser les
# commissions des revendeurs — donc BOTH pour que Suguba fonctionne
# entièrement. Une clé au mauvais scope échoue en 403 (api_key_scope_forbidden).
# Utilisez sk_test_... tant que vous n'êtes pas passé en production.
SASPAY_API_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"

# SASPAY_WEBHOOK_SECRET vérifie la signature des notifications reçues sur
# /api/webhooks/saspay (HMAC-SHA256 de "timestamp.corps"). Sans elle,
# l'endpoint refuse TOUTE notification — jamais de repli permissif sur une
# route qui marque des commandes payées.
# ⚠️ Ce secret n'est affiché QU'UNE FOIS, à la création du webhook dans le
# tableau de bord SasPay. Perdu, il faut en générer un nouveau
# (Webhooks > Changer le secret).
SASPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# Le webhook se déclare depuis le tableau de bord SasPay (pas par API) :
#   URL      : https://app.sugubaml.com/api/webhooks/saspay
#   Events   : transaction.created, transaction.success,
#              transaction.failed, transaction.cancelled
#
# Réseaux disponibles au Mali : orange_ml, moov_ml, mobi_cash_ml.
# ⚠️ Wave n'est PAS couvert par SasPay au Mali. Le portail Diaspora utilise
# le réseau global `card` (carte bancaire, facturée en USD).

# 6. CONTACT OPS MASTER DESK (BAMAKO)
NEXT_PUBLIC_OFFICIAL_PHONE="+22389460000"
NEXT_PUBLIC_OFFICIAL_WHATSAPP="22389460000"
