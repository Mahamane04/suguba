# ==============================================================================
# SUGUBA SAAS — VARIABLES D'ENVIRONNEMENT DE PRODUCTION
# Conforme aux spécifications MicroOffice SaaS Factory V3.1
# ==============================================================================

# 1. URL DE L'APPLICATION
NEXT_PUBLIC_APP_URL="https://app.sugubaml.com"
PORT=3000

# 2. BASE DE DONNÉES POSTGRESQL & SUPABASE CLOUD
# (Laissez vide pour le mode Local Offline-First / Démo automatique)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 3. PASSERELLE MOBILE MONEY WAVE (MALI)
# Obtenu auprès de Wave Business Mali (https://wave.com)
WAVE_API_KEY="wave_live_key_xxxxxxxxxxxxxxxx"
WAVE_MERCHANT_ID="mer_suguba_mali"
WAVE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# 4. PASSERELLE ORANGE MONEY & MOOV MONEY (CINETPAY / HUB2)
# Obtenu auprès de CinetPay Mali (https://cinetpay.com)
CINETPAY_API_KEY="cinetpay_api_key_xxxxxxxxxxxx"
CINETPAY_SITE_ID="123456"
CINETPAY_SECRET_KEY="cinetpay_secret_xxxxxxxx"

# 5. PASSERELLE SMS TRANSACTIONNELS (OTP & NOTIFICATIONS LIVRAISON)
SMS_GATEWAY_URL="https://api.sms-mali.com/v1/send"
SMS_GATEWAY_API_KEY="sms_api_key_xxxxxxxxxxxxxx"
SMS_SENDER_ID="SUGUBA"

# 6. CONTACT OPS MASTER DESK (BAMAKO)
NEXT_PUBLIC_OFFICIAL_PHONE="+22389460000"
NEXT_PUBLIC_OFFICIAL_WHATSAPP="22389460000"
